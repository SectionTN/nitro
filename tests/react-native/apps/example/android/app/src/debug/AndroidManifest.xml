<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:usesCleartextTraffic="true"
        tools:targetApi="28"
        tools:ignore="GoogleAppIndexingWarning">
        <!--
            Harness asserts view reuse within one surface, so overlays must not recreate the debug host.
            TODO: Remove this override once a Harness release provides stable-host handling for overlay updates:
            https://github.com/callstackincubator/react-native-harness/issues/271
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|assetsPaths"
            tools:replace="android:configChanges"/>
    </application>
</manifest>
