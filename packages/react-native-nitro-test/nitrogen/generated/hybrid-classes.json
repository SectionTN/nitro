        "allowMultipleImplementations": true,
        "implementation": {
          "className": "HybridBase"
        },
        "language": "swift"
      }
    },
    "Child": {
      "android": {
        "allowMultipleImplementations": true,
        "implementation": {
          "className": "HybridChild"
        },
        "language": "kotlin"
      },
      "ios": {
        "allowMultipleImplementations": true,
        "implementation": {
          "className": "HybridChild"
        },
        "language": "swift"
      }
    },
    "PlatformObject": {
      "android": {
        "implementation": {
          "className": "HybridPlatformObject"
        },
        "language": "kotlin"
      },
      "ios": {
        "implementation": {
          "className": "HybridPlatformObject"
        },
        "language": "swift"
      }
