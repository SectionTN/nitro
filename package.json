{
  "name": "nitro",
  "description": "Fast, type-safe native modules for React Native with statically compiled JSI bindings.",
  "homepage": "https://nitro.margelo.com",
  "packageManager": "bun@1.3.14",
  "private": true,
  "version": "0.37.1",
  "repository": "https://github.com/margelo/nitro.git",
  "author": "Marc Rousavy <me@mrousavy.com> (https://github.com/mrousavy)",
  "workspaces": [
    "packages/nitro-core",
    "packages/nitrogen"
  ],
  "scripts": {
    "postinstall": "bun run build && bun install --ignore-scripts --frozen-lockfile",
    "build": "bun run check-versions && bun nitro build && bun nitrogen build",
    "bootstrap": "bun install --frozen-lockfile",
    "typecheck": "bun nitro typecheck && bun nitrogen typecheck",
    "lint": "bun nitro lint && bun nitrogen lint",
    "lint-cpp": "./scripts/clang-format.sh",
    "lint-swift": "./scripts/swift-format.sh",
    "lint-kotlin": "./scripts/kotlin-format.sh",
    "lint-all": "bun lint-cpp && bun lint-swift && bun lint-kotlin && bun lint",
    "clean": "git clean -dfx",
    "release": "./scripts/release.sh",
    "nitro": "bun --cwd packages/nitro-core",
    "nitrogen": "bun --cwd packages/nitrogen",
    "version:set": "node scripts/set-version.mjs",
    "check-versions": "node scripts/set-version.mjs --check",
    "test": "bun run --cwd packages/nitro-core test"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@jamesacarr/eslint-formatter-github-actions": "^0.2.0",
    "@react-native/eslint-config": "0.85.3",
    "@release-it-plugins/workspaces": "^5.0.3",
    "@release-it/conventional-changelog": "^10.0.6",
    "@types/bun": "1.4.0",
    "eslint": "^9.39.4",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "release-it": "^19.2.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireCleanWorkingDir": true
    },
    "github": {
      "release": true
    },
    "hooks": {
      "before:init": "bun run check-versions && bun run build && bun run typecheck",
      "after:bump": "node scripts/set-version.mjs && bun install --ignore-scripts && bun run build"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "✨ Features"
            },
            {
              "type": "perf",
              "section": "💨 Performance Improvements"
            },
            {
              "type": "fix",
              "section": "🐛 Bug Fixes"
            },
            {
              "type": "chore(deps)",
              "section": "🛠️ Dependency Upgrades"
            },
            {
              "type": "docs",
              "section": "📚 Documentation"
            }
          ]
        }
      },
      "@release-it-plugins/workspaces": {
        "workspaces": [
          "packages/nitro-core",
          "packages/nitrogen"
        ],
        "additionalManifests": {
          "versionUpdates": [
            "packages/react-native-nitro-modules/package.json"
          ]
        }
      }
    }
  }
}
